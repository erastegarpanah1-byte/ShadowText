    <string name="settings_about_what_title">What is ShadowText?</string>
    <string name="settings_about_what_body">ShadowText is an offline text steganography engine for Android. It lets you hide secret messages inside ordinary-looking text using invisible Unicode characters — making your hidden data completely undetectable to the naked eye.</string>
    <string name="settings_about_goal_title">Our Goal</string>
    <string name="settings_about_goal_body">We believe privacy is a fundamental right. Our goal is to make secure, invisible communication accessible to everyone — no accounts, no internet, no tracking. Just you and your secrets, protected by strong encryption and hidden in plain sight.</string>
    <string name="settings_about_how_title">How It\'s Built</string>
    <string name="settings_about_how_arch">Architecture — MVVM + Clean Architecture for separation of concerns and testability</string>
    <string name="settings_about_how_ui">UI — Jetpack Compose with Material 3, supporting dark and light themes</string>
    <string name="settings_about_how_security">Security — AES-256 encryption with advanced steganography techniques</string>
    <string name="settings_about_how_privacy">Privacy — 100% offline, all processing happens on your device</string>
    <string name="settings_about_how_stego">Steganography — Zero Width Characters and Homoglyph methods</string>
    <string name="settings_security_first">SECURITY FIRST</string>
    <string name="settings_processing">All processing is done on your device.</string>
    <string name="settings_no_leak">Your data never leaves your device.</string>
