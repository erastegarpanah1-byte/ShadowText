    <string name="settings_about">About ShadowText</string>
    <string name="settings_version">Version 1.0.0</string>
    <string name="settings_about_tagline">Steganography. Offline. Private.</string>
    <string name="settings_about_intro">ShadowText is a modern steganography tool for hiding and retrieving data.</string>
    <string name="settings_about_intro_body">With ShadowText you can hide various data inside supported carrier content, then extract and recover it on the same device — no internet connection required.</string>
    <string name="settings_about_privacy_title">Designed with Privacy in Mind</string>
    <string name="settings_about_privacy_body">ShadowText is designed for local processing.\n\nNo accounts. No servers. No data sent to the internet.\n\nData you enter into the app for processing is never sent to any server for steganography operations.</string>
    <string name="settings_about_features_title">Features</string>
    <string name="settings_about_features">• Hide data inside text\n• Extract hidden data\n• Fully offline processing\n• Architecture ready for future security capabilities</string>
    <string name="settings_about_note_title">An Important Note</string>
    <string name="settings_about_note_body">ShadowText is a technical and educational tool.\n\nIts capabilities should only be used on data you own or have legal permission to process.\n\nResponsibility for how the software is used and for the data processed rests with the user.</string>
